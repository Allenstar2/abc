Ac7 [hold q7] c7 and2
Ao7 [a7 b7 c7] d7 or3
Af7 d7 clkr NULL NULL q7 qb7 dff1
Adac7 [qb7] [g7] dacb
Ms7 vout g7 vin vin PMOS W=130u L=0.18u

Aa8 [up q7] a8 and2
Ab8 [dn q9] b8 and2
Ac8 [hold q8] c8 and2
Ao8 [a8 b8 c8] d8 or3
Af8 d8 clkr NULL NULL q8 qb8 dff1
Adac8 [qb8] [g8] dacb
Ms8 vout g8 vin vin PMOS W=130u L=0.18u

.control
tran 2e-09 0.00018700000000000007 0 1e-08
wrdata /home/user/abc/ldo-research/sim/results/s13_tmp_tr.txt v(vout) v(pg) v(g1) v(g2) v(g3) v(g4) v(g5) v(g6) v(g7) v(g8)
