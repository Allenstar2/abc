* s13_tmp
.include /home/user/abc/ldo-research/sim/models/180nm_bulk.pm
.options temp=27 reltol=1e-4 abstol=1e-12 vntol=1e-7

.subckt ldoA vin vout vref fb fbi pg
Ibias vin bn 1e-05
Mbn bn bn 0 0 NMOS W=4u L=1u
Mt tail bn 0 0 NMOS W=8u L=1u
M1 d1 fbi tail 0 NMOS W=20u L=1.0u
M2 ea vref tail 0 NMOS W=20u L=1.0u
M3 d1 d1 vin vin PMOS W=4u L=1.0u
M4 ea d1 vin vin PMOS W=4u L=1.0u
Mbn2 bp bn 0 0 NMOS W=4u L=1u
Mbp bp bp vin vin PMOS W=4u L=1u
Mcs pg bp vin vin PMOS W=20u L=1u
Mb 0 ea pg pg PMOS W=20u L=0.18u
Mp vout pg vin vin PMOS W=800u L=0.18u
R1 vout fb 4000.0
R2 fb 0 4000.0
Cc vout ea 5e-12
.ends

VIN vin 0 DC 1.8
VREF vref 0 0.8
X1 vin vout vref fb fb pg ldoA
CL vout 0 1e-10
IL vout 0 PWL(0 0 1e-06 0 1.05e-06 0.005 7e-06 0.005 7.05e-06 0.008 1.3e-05 0.008 1.305e-05 0.011 1.9e-05 0.011 1.905e-05 0.014 2.5e-05 0.014 2.505e-05 0.017 3.1e-05 0.017 3.105e-05 0.02 3.7e-05 0.02 3.705e-05 0.023 4.3e-05 0.023 4.305e-05 0.026 4.9e-05 0.026 4.905e-05 0.029 5.5e-05 0.029 5.505e-05 0.032 6.1e-05 0.032 6.105e-05 0.035 6.7e-05 0.035 6.705e-05 0.038 7.3e-05 0.038 7.305e-05 0.041 7.9e-05 0.041 7.905e-05 0.044 8.5e-05 0.044 8.505e-05 0.047 9.1e-05 0.047 9.105e-05 0.05 9.7e-05 0.05 9.705e-05 0.053 0.000103 0.053 0.00010305 0.056 0.000109 0.056 0.00010905 0.059 0.000115 0.059 0.00011505 0.062 0.000121 0.062 0.00012105 0.065 0.000127 0.065 0.00012705 0.068 0.000133 0.068 0.00013305 0.071 0.000139 0.071 0.00013905 0.074 0.000145 0.074 0.00014505 0.077 0.000151 0.077 0.00015105 0.08 0.000157 0.08 0.00015705 0.083 0.000163 0.083 0.00016305 0.086 0.000169 0.086 0.00016905 0.089 0.000175 0.089 0.00017505 0.092 0.000181 0.092 0.00018105 0.095)

Vclk clka 0 PULSE(0 1.8 5e-08 0.1n 0.1n 4.99e-08 1e-07)
Vclkr clkra 0 PULSE(0 1.8 5.1e-08 0.1n 0.1n 1.4989999999999999e-07 3e-07)
Vvl vl 0 1.155
Vvh vh 0 1.39
Bup upa 0 V = 0.9*(1+tanh((V(vl)-V(pg))*2000))
Bdn dna 0 V = 0.9*(1+tanh((V(pg)-V(vh))*2000))
.model adcb adc_bridge(in_low=0.9 in_high=0.9 rise_delay=1e-09 fall_delay=1e-09)
Aadc [clka upa dna clkra] [clk up0 dn0 clkr] adcb
.model dff1 d_dff(clk_delay=2e-10 set_delay=2e-10 reset_delay=2e-10 ic=0 rise_delay=1e-10 fall_delay=1e-10)
.model and2 d_and(rise_delay=5e-11 fall_delay=5e-11)
.model or3 d_or(rise_delay=5e-11 fall_delay=5e-11)
.model nor2 d_nor(rise_delay=5e-11 fall_delay=5e-11)
.model one d_pullup
.model zero d_pulldown
Ahi q0 one
Alo q9 zero
* 比較器輸出同步器（2 級 DFF）
Asu1 up0 clk NULL NULL upq1 NULL dff1
Asd1 dn0 clk NULL NULL dnq1 NULL dff1
Asu2 upq1 clk NULL NULL up NULL dff1
Asd2 dnq1 clk NULL NULL dn NULL dff1
Ahold [up dn] hold nor2
.model dacb dac_bridge(out_low=0 out_high=1.8 out_undef=0.9 input_load=1e-12 t_rise=1e-09 t_fall=1e-09)

Aa1 [up q0] a1 and2
Ab1 [dn q2] b1 and2
Ac1 [hold q1] c1 and2
Ao1 [a1 b1 c1] d1 or3
Af1 d1 clkr NULL NULL q1 qb1 dff1
Adac1 [qb1] [g1] dacb
Ms1 vout g1 vin vin PMOS W=130u L=0.18u

Aa2 [up q1] a2 and2
Ab2 [dn q3] b2 and2
Ac2 [hold q2] c2 and2
Ao2 [a2 b2 c2] d2 or3
