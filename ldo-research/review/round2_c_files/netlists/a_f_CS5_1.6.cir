.options reltol=1e-4
* 5-stage current-starved ring; bias from resistor to vdd
Rb vdd nb 20k
Mnb nb nb 0 0 NMOS W=2u L=0.5u
Mn2 pb nb 0 0 NMOS W=2u L=0.5u
Mpb pb pb vdd vdd PMOS W=5u L=0.5u
Mpc0 xp0 pb vdd vdd PMOS W=5u L=0.5u
Mps0 n1 n0 xp0 vdd PMOS W=2u L=0.18u
Mns0 n1 n0 xn0 0 NMOS W=1u L=0.18u
Mnc0 xn0 nb 0 0 NMOS W=2u L=0.5u
Cl0 n1 0 20f
Mpc1 xp1 pb vdd vdd PMOS W=5u L=0.5u
Mps1 n2 n1 xp1 vdd PMOS W=2u L=0.18u
Mns1 n2 n1 xn1 0 NMOS W=1u L=0.18u
Mnc1 xn1 nb 0 0 NMOS W=2u L=0.5u
Cl1 n2 0 20f
Mpc2 xp2 pb vdd vdd PMOS W=5u L=0.5u
Mps2 n3 n2 xp2 vdd PMOS W=2u L=0.18u
Mns2 n3 n2 xn2 0 NMOS W=1u L=0.18u
Mnc2 xn2 nb 0 0 NMOS W=2u L=0.5u
Cl2 n3 0 20f
Mpc3 xp3 pb vdd vdd PMOS W=5u L=0.5u
Mps3 n4 n3 xp3 vdd PMOS W=2u L=0.18u
Mns3 n4 n3 xn3 0 NMOS W=1u L=0.18u
Mnc3 xn3 nb 0 0 NMOS W=2u L=0.5u
